# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: ccLib.XmlDates
  version: 1.0.0
  description: XML Date Conversion by Cornelius Concepts
  icon: E:\BUSINESS\Cornelius Concepts\marketing\LOGO\Logo150.png
  authors:
    - David Cornelius
  projectUrl: https://github.com/corneliusdavid/ccLib
  repositoryUrl: https://github.com/corneliusdavid/ccLib
  license: MIT
  copyright: David Cornelius and contributors
  frameworks:
    - vcl
targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
templates:
  - name: default
    source:
      - src: ./../source/misc/uXmlDates.pas
      - src: ./ccLib.XmlDates.dpk
      - src: ./ccLib.XmlDates.dproj
    build:
      - project: ./ccLib.XmlDates.dproj
        platforms:
          - win32
          - win64
