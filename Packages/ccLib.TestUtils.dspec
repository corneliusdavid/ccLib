# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: ccLib.TestUtils
  version: 1.0.0
  description: Testing Functions by Cornelius Concepts
  icon: Logo64.png
  authors:
    - David Cornelius
  projectUrl: https://github.com/corneliusdavid/ccLib
  repositoryUrl: https://github.com/corneliusdavid/ccLib
  license: MIT
  copyright: David Cornelius and contributors
  frameworks:
    - vcl
targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi13.0
    platforms:
      - Win32
      - Win64
templates:
  - name: default
    source:
      - src: ./../source/misc/uTestUtils.pas
      - src: ./ccLib.TestUtils.dpk
      - src: ./ccLib.TestUtils.dproj
    build:
      - project: ./ccLib.TestUtils.dproj
        platforms:
          - win32
          - win64
