# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: ccLib.LayoutSaver
  version: 1.0.0
  description: VCL LayoutSaver by Cornelius Concepts
  icon: E:\BUSINESS\Cornelius Concepts\marketing\LOGO\Logo150.png
  authors:
    - David Cornelius
  projectUrl: https://github.com/corneliusdavid/ccLib
  repositoryUrl: https://github.com/corneliusdavid/ccLib
  license: MIT
  copyright: David Cornelius and contributors
  frameworks:
    - vcl
targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
templates:
  - name: default
    source:
      - src: ./ccLib.LayoutSaver_R.dpk
      - src: ./ccLib.LayoutSaver_R.dproj
      - src: ./ccLib.LayoutSaver_D.dpk
      - src: ./ccLib.LayoutSaver_D.dproj
      - src: ./../source/layoutsaver/*.pas
      - src: ./../source/ccRegCommon.pas
      - src: ./../source/cc_reg.pas
      - src: ./../source/*.inc
      - src: ./cc.res
    build:
      - project: ./ccLib.LayoutSaver_R.dproj
        platforms:
          - win32
          - win64
        defines: RELEASE
    design:
      - project: ./ccLib.LayoutSaver_D.dproj
        platforms:
          - win32
        libSuffx: $libsuffix$
        defines: RELEASE
