# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: ccLib.Utils
  version: 1.0.3
  description: 'A few utilities from Cornelius Concepts: LayoutSaver and CloseApplication components; XML date conversion, test data generation; recursive directory search.'
  icon: Logo64.png
  authors:
    - David Cornelius
  projectUrl: https://github.com/corneliusdavid/ccLib
  repositoryUrl: https://github.com/corneliusdavid/ccLib
  license: MIT
  copyright: David Cornelius
  tags:
    - VCL
    - Utilities
  frameworks:
    - vcl
  readme: ..\README.md
variables:
  packagesource: ./Delphi $compilerNoPrefix$
targetPlatforms:
  - compiler from: delphixe2
    compiler to: delphi12.0
    platforms:
      - win32
      - win64
  - compiler: delphi13.0
    platforms:
      - win32
      - win64
    variables:
      packageSource: ./Delphi 12.0
templates:
  - name: default
    source:
      - src: ./$packageSource$/*.dpk
      - src: ./$packageSource$/*.dproj
      - src: ./../source/layoutsaver/*.pas
      - src: ./../source/layoutsaver/*.dcr
      - src: ./../source/idleclose/*.pas
      - src: ./../source/idleclose/*.dfm
      - src: ./../source/idleclose/*.dcr
      - src: ./../source/elapsedtimer/*.pas
      - src: ./../source/misc/*.pas
      - src: ./../source/*.res
      - src: ./../source/*.pas
      - src: ./../source/*.inc
    build:
      - project: ./$packageSource$/ccLib_R.dproj
        platforms:
          - win32
          - win64
        defines: RELEASE
    design:
      - project: ./$packageSource$/ccLib_D.dproj
        platforms:
          - win32
        defines: RELEASE
