# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: ccLib.Utils
  version: 1.0.0
  description: Cornelius Concepts Library
  icon: Logo64.png
  authors:
    - David Cornelius
  projectUrl: https://github.com/corneliusdavid/ccLib
  repositoryUrl: https://github.com/corneliusdavid/ccLib
  license: MIT
  copyright: David Cornelius and contributors
  frameworks:
    - vcl
targetPlatforms:
  - compiler from: delphixe2
    compiler to:   delphi11
    template: classic
    platforms:
      - Win32
      - Win64
  - compiler from: delphi12.0
    compiler to:   delphi13.0
    template: default
    platforms:
      - Win32
      - Win64
templates:
  - name: classic
    source:
      - src: ./Delphi $compilermajornoprefix$/*.dpk
      - src: ./Delphi $compilermajornoprefix$/*.dproj
      - src: ./../source/layoutsaver/*.pas
      - src: ./../source/idleclose/*.pas
      - src: ./../source/idleclose/*.dfm
      - src: ./../source/misc/*.pas
      - src: ./../source/*.res
      - src: ./../source/*.pas
      - src: ./../source/*.inc
    build:
      - project: ./Delphi $compilermajornoprefix$/ccLib_R.dproj
        platforms:
          - win32
          - win64
        defines: RELEASE
    design:
      - project: ./Delphi $compilermajornoprefix$/ccLib_D.dproj
        platforms:
          - win32
        defines: RELEASE
  - name: default
    source:
      - src: ./Delphi 12/*.dpk
      - src: ./Delphi 12/*.dproj
      - src: ./../source/layoutsaver/*.pas
      - src: ./../source/idleclose/*.pas
      - src: ./../source/idleclose/*.dfm
      - src: ./../source/misc/*.pas
      - src: ./../source/*.res
      - src: ./../source/*.pas
      - src: ./../source/*.inc
    build:
      - project: ./Delphi 12/ccLib_R.dproj
        platforms:
          - win32
          - win64
        defines: RELEASE
    design:
      - project: ./Delphi 12/ccLib_D.dproj
        platforms:
          - win32
        defines: RELEASE
